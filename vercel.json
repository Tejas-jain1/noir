{
  "rewrites": [
    {
      "source": "/api/spotify-import",
      "destination": "/api/spotify-import.js"
    },
    {
      "source": "/api/saavn/(.*)",
      "destination": "https://www.jiosaavn.com/api.php?$1"
    },
    {
      "source": "/api/saavn",
      "destination": "https://www.jiosaavn.com/api.php"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
