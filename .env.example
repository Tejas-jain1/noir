# YouTube Data API v3 Key (Optional)
# If omitted, NOIR uses the authentic internal curated catalog automatically.
# You can also enter and update your API key directly inside the in-app Settings modal.
VITE_YOUTUBE_API_KEY=

# Spotify Web API Client ID (Optional).
# Zero-API-key public embed scraper works automatically out of the box without any Spotify developer keys.
VITE_SPOTIFY_CLIENT_ID=
