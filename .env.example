# YouTube Data API v3 Key (Optional)
# If omitted, NOIR uses the authentic internal curated catalog automatically.
VITE_YOUTUBE_API_KEY=

# Audius App Name (Optional)
# Identifies your app to Audius decentralized discovery nodes. Defaults to "NOIR_MUSIC_PLAYER" if omitted.
VITE_AUDIUS_APP_NAME=NOIR_MUSIC_PLAYER

# Supabase Configuration for Cloud Sync, Auth & Custom Audio Storage (Optional)
# If omitted, NOIR stores your library in offline browser IndexedDB storage.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
